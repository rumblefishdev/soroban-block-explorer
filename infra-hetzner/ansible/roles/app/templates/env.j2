# Managed by infra-hetzner/ansible/roles/app — do not edit by hand.
# Re-rendered on every `ansible-playbook --tags app` run from the
# operator's environment variables. Changes made here directly will
# be lost on the next run.

# Public DNS that Caddy serves on. Used as both the Caddyfile site
# block address and the ACME http-01 challenge target.
CH_DOMAIN={{ ch_domain }}

# Let's Encrypt account email — receives expiry-warning mail.
ACME_EMAIL={{ acme_email }}

# Password for the `default` ClickHouse user (host-side admin only —
# sidecar, backup, SSH→docker exec). External clients reach scoped
# users or `dev_shared` via Caddy without ever touching this. Compose
# refuses to start if unset (`${CLICKHOUSE_PASSWORD:?...}` in
# docker-compose.prod.yml).
CLICKHOUSE_PASSWORD={{ clickhouse_password }}
