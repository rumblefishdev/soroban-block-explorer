# Caddy reverse proxy for the Hetzner ch-prod-01 box.
#
# Terminates TLS using a Let's Encrypt server certificate and
# enforces mTLS against the team-owned CA. ClickHouse listens only
# on the Docker bridge — the loopback host-port bindings in the
# production compose overlay mean Caddy is the only path from the
# public network to CH.
#
# ## Connection lifecycle
#
#   1. Client opens TCP :443 → TLS handshake begins.
#   2. Caddy presents the LE server certificate; client validates it.
#   3. Caddy requests a client certificate (`client_auth`).
#   4. Client sends its certificate; Caddy verifies the signature
#      against `/etc/caddy/clients-ca.pem`. A missing or
#      untrusted certificate aborts the handshake here — the
#      request never reaches a CH backend.
#   5. Caddy reverse-proxies the HTTP request to clickhouse:8123
#      over the Docker bridge (plaintext, intra-host).
#
# ## Why HTTP between Caddy and CH (intra-host)
#
# Caddy and CH share a kernel network namespace via the Compose
# bridge. The hop is not observable from outside the box; adding
# a second TLS layer would burn CPU on each query for no security
# gain. The production posture is "TLS at the edge, plaintext on
# the loopback", same as virtually every reverse-proxy deployment.

{
	# Email used for Let's Encrypt account registration and
	# expiry notifications. Sourced from the host environment so
	# the same Caddyfile works across staging / production.
	email {$ACME_EMAIL}

	# The admin endpoint binds to 127.0.0.1:2019 inside the
	# container by default — used by the Compose healthcheck.
	# Explicitly named here so a future global-block change does
	# not accidentally publish it.
	admin localhost:2019

	# Structured logs to stdout; Docker's json-file driver
	# captures them. JSON makes downstream ingestion (e.g. into
	# CH itself or a future Loki) straightforward.
	#
	# `format filter` wraps the JSON encoder and redacts sensitive
	# query-string parameters + auth headers BEFORE they hit the
	# wire. ClickHouse's HTTP API accepts `?user=…&password=…` in
	# the URL; without this filter Caddy's default JSON access log
	# would persist plaintext credentials into stdout (and from
	# there into the Docker json-file driver + any downstream
	# log aggregation). Authorization and Cookie headers are
	# dropped as defence-in-depth — neither is part of the
	# expected mTLS flow, so logging them only adds risk.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace password REDACTED
					replace user REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
		level INFO
	}

	# Surface upstream failures clearly instead of returning
	# Caddy's stock 502 page, which leaks the proxy identity.
	#
	# `protocols h1 h2` pins HTTP versions to TCP-only. Caddy 2
	# enables HTTP/3 (QUIC over UDP/443) by default; the host
	# firewall (ufw) only allows TCP/443 and the Hetzner network-
	# switch ACL likewise blocks UDP/443, so HTTP/3 would
	# generate continuous listener-failure warnings without ever
	# carrying real traffic. Pin to h1+h2 explicitly to silence
	# the noise and keep the wire surface aligned with the
	# firewall.
	servers {
		strict_sni_host on
		protocols h1 h2
	}
}

{$CH_DOMAIN} {
	tls {
		# Both directions of mutual authentication. `require_and_verify`
		# rejects any handshake that does not present a certificate
		# signed by our CA — this is the first auth gate.
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/caddy/clients-ca.pem
		}

		# TLS 1.3 only. All clients in this deployment (AWS
		# Lambda Node/Python runtimes, ECS Galexie, modern
		# clickhouse-client, browsers ≤ 2 years old) support
		# 1.3 natively. Pinning to 1.3 eliminates the TLS 1.2
		# cipher-suite review surface entirely (no ECDHE-RSA
		# vs CHACHA20 vs AES-GCM choice exposed) and forces
		# forward secrecy in every handshake.
		protocols tls1.3
	}

	# Defensive HTTP response headers. None of these change
	# behaviour for legitimate API clients; they harden the
	# response surface in case a misconfigured public client
	# (e.g. a browser tab pointed at the prod domain) ever lands
	# on this endpoint.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Drop the default Server header — the back-end identity
		# is not useful to anyone who reached this stage.
		-Server
	}

	# Per-site access log. The header values cover the audit
	# trail we want for cross-cloud queries:
	#   - which client cert presented (CN)
	#   - which AWS / dev origin (User-Agent)
	#   - which CH endpoint hit
	#
	# Filter mirrors the global block: redact `password` and
	# `user` query params and drop auth-related headers. Same
	# rationale — CH HTTP API accepts URL-embedded credentials
	# and we must not persist them to disk.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace password REDACTED
					replace user REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# Body-size ceiling. Backfill writes from the writer can be
	# in the multi-MB range (block of column data per partition
	# flush). 256 MiB is well above the worst observed batch but
	# low enough to refuse obvious abuse early.
	request_body {
		max_size 256MB
	}

	# Second auth gate + identity assertion: the snippet defines a
	# `map` directive that translates the verified mTLS subject DN
	# into a ClickHouse user name (`{ch_user}`). Service certs map
	# to scoped users (`api_reader`, `galexie`, …); dev certs map
	# to `dev_shared` (admin user with `<no_password/>` restricted
	# to loopback/bridge — keeps the password-protected `default`
	# unreachable from the Caddy path). Any CN absent from the map
	# gets the `__unmapped__` sentinel (the map's `default`) — the
	# @no_user matcher below rejects with 403 before any backend hop.
	# (A bare `== ""` did NOT work: an unset/empty {ch_user} does not
	# compare equal to "" inside Caddy's CEL `expression` matcher, so
	# the gate never fired — task 0241. The non-empty sentinel makes
	# the var always set, so the comparison is reliable.) The map IS
	# the allowlist:
	# one source of truth, populated by Ansible from
	# `clickhouse_cn_user_pairs` in group_vars (task 0240).
	#
	# This is the proactive equivalent of the CRL/OCSP revocation
	# story documented in infra-hetzner/ca/README.md — losing a
	# laptop or rotating a service cert is a 1-line edit in
	# group_vars + a playbook re-run, not a CA rotation.
	#
	# `snippets/` is a directory bind-mounted from the host's
	# `/srv/caddy/`, where Ansible writes the file. Mounting the
	# directory (not the single file) avoids the docker-bind-mount
	# auto-create-as-directory failure mode if the file is ever
	# absent at compose-up time.
	import snippets/cn_user_map.snippet

	# Wrap the gate + proxy in an explicit `route` so its directives run
	# in SOURCE order. Without it, Caddy's default directive order runs
	# `reverse_proxy` before `respond`, so the `@no_user` 403 never fires
	# and unmapped (but CA-valid) certs reach ClickHouse — rejected only by
	# CH's password backstop, not at the edge. See task 0241.
	route {
	@no_user expression `{ch_user} == "__unmapped__"`
	respond @no_user `{"error":"unauthorized client"}` 403 {
		close
	}

	# Strip any client-supplied ClickHouse credential carriers
	# BEFORE proxying. CH 26.3 rejects requests that mix
	# `X-ClickHouse-User` header auth with URL-param `?user=` /
	# `?password=` auth (`Invalid authentication: it is not
	# allowed to use X-ClickHouse HTTP headers and authentication
	# via parameters simultaneously`). Without these strips a
	# well-meaning client that sends `?user=…` for backwards
	# compat would self-DoS as soon as Caddy adds its own
	# `X-ClickHouse-User` header below.
	#
	# `request_header` operates on the request before
	# `reverse_proxy`'s `header_up` runs. `uri query -<param>`
	# removes the named query parameter from the request URL.
	request_header -X-ClickHouse-User
	request_header -X-ClickHouse-Key
	uri query -user
	uri query -password

	reverse_proxy clickhouse:8123 {
		# Identity assertion. `header_up` in set-mode replaces any
		# residual client-supplied value with the map's verified
		# output. Combined with the request_header strip above, the
		# request reaching CH contains EXACTLY one identity claim,
		# from Caddy's verified mTLS map. Verified empirically on
		# Caddy 2.10 (task 0240 Phase 0 V1). CH (`<no_password/>`
		# users restricted to the compose bridge subnet) trusts
		# this header as the sole auth signal; the cert is the
		# credential, this header carries the cert's resolved
		# identity.
		header_up X-ClickHouse-User {ch_user}

		# Forward TLS metadata so CH access logs (and downstream
		# audit) can attribute requests to the presenting client
		# beyond the CH user name. `subject` is the only Caddy-
		# registered placeholder for the client cert's identity;
		# `subject_cn` does not exist (silently emits empty).
		# Downstream audit consumers parse the CN out of the full
		# DN with a substr / regex.
		header_up X-Client-Subject {http.request.tls.client.subject}
		header_up X-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}

		# Timeouts cover the longest legitimate analytical
		# query we expect (mirrored from the pilot users.d
		# /timeouts.xml 7200 s window).
		#
		# `response_header_timeout` bounds time to FIRST BYTE,
		# not query duration. CH flushes a streaming SELECT's
		# headers immediately, but sends nothing until it
		# finishes for anything that buffers (INSERT … SELECT,
		# CREATE TABLE AS, a heavy GROUP BY, OPTIMIZE). Held at
		# 30 s it disconnected exactly those, while CH ran on,
		# committed the rows and logged QueryFinish — the work
		# done, the caller told it failed (task 0331 here; 26
		# days of a dead prices worker next door, task 0513).
		# It never bounded a runaway either: a runaway streams,
		# so it always passed. All four values now state the
		# one window the comment above promises.
		transport http {
			dial_timeout 10s
			response_header_timeout 7200s
			read_timeout 7200s
			write_timeout 7200s
		}
	}
	}
}
