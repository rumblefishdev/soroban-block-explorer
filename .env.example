AWS_REGION=us-east-1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soroban_block_explorer
DATABASE_SECRET_ARN=
NODE_ENV=dev
NX_CLOUD_ACCESS_TOKEN=
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# --- Postgres compose service (overrides built-in default 5432) ---
POSTGRES_PORT=5432

# --- ClickHouse pilot (ADR 0044, task 0204; crates/db-clickhouse) ---
# Host-side ports for the `clickhouse` compose service. Override if the
# defaults clash with another local ClickHouse (e.g. an unrelated
# ch-mirror container).
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# URL/credentials consumed by the Rust CLI + smoke test
# (`cargo run -p db-clickhouse --bin db-clickhouse-init`,
#  `cargo test -p db-clickhouse --test smoke`).
# Keep the password aligned with the literal in
# `crates/db-clickhouse/schema/init.sql` (transaction_hash_dict SOURCE)
# — diverging breaks the dictionary load.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
