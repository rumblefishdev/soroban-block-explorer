#!/usr/bin/env sh
# Worktrees point core.hooksPath at the MAIN checkout's .husky/_, so git starts
# the main checkout's copy of this script. Run this checkout's own copy instead.
own="$(git rev-parse --show-toplevel)/.husky/$(basename "$0")"
[ "$0" -ef "$own" ] || { [ -f "$own" ] && exec sh -e "$own" "$@"; exit 0; }

# Fresh worktrees have no node_modules, so husky's other hooks (lint-staged
# prettier/rustfmt, affected checks) crash with "Could not find Nx modules"
# and get skipped — unformatted code then fails CI 12 min later. Install on
# checkout so the gate always runs. pnpm links from its global store, so this
# is a real per-worktree tree: `@rumblefish/*` resolve to THIS checkout's libs/.
# Never bypass hooks with --no-verify — see "Git Hooks" in CLAUDE.md.

# $3 == 1 → branch checkout (incl. `git worktree add`); 0 → file checkout. Only
# act on branch checkouts so a `git checkout -- file` never touches node_modules.
[ "$3" = '1' ] || exit 0

if [ -L node_modules ]; then
  echo "husky - node_modules is a symlink (npm-era worktree layout); repair:"
  echo "husky -   mv node_modules \"\$(git worktree list --porcelain | awk '/^worktree /{print \$2; exit}')/.trash/node_modules.\$\$\" && pnpm install --frozen-lockfile"
  exit 0
fi
# No "node_modules exists → skip": an existing tree can be stale (the lockfile
# changed across the branch switch, or an npm-era layout pnpm cannot read) and
# the pre-commit gate then fails inside nx. On an up-to-date tree this is a
# ~1 s no-op ("Already up to date", measured 2026-09-16), and pnpm rebuilds an
# npm-layout tree without prompting.
pnpm install --frozen-lockfile --prefer-offline ||
  echo "husky - pnpm install failed; commit hooks will not run until it succeeds"
exit 0
