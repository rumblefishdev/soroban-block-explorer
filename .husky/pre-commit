#!/usr/bin/env sh
# Worktrees point core.hooksPath at the MAIN checkout's .husky/_, so git starts
# the main checkout's copy of this script. Run this checkout's own copy instead.
own="$(git rev-parse --show-toplevel)/.husky/$(basename "$0")"
[ "$0" -ef "$own" ] || { [ -f "$own" ] && exec sh -e "$own" "$@"; exit 0; }

set -e
pnpm exec lint-staged

# Lint, typecheck and test the Nx projects the staged files belong to, deleted
# files included: Nx maps a path to its project whether or not the file still
# exists. A move lists both paths (--no-renames), so the project it leaves is
# checked too. Markdown feeds none of the three, so a commit of documents alone
# never starts Nx.
files="$(git diff --cached --name-only --no-renames | grep -v '\.md$' || true)"
if [ -n "$files" ]; then
  printf '%s\n' "$files" |
    pnpm exec nx affected -t lint typecheck test --stdin --outputStyle=static
fi
