#!/usr/bin/env sh
# Worktrees point core.hooksPath at the MAIN checkout's .husky/_, so git starts
# the main checkout's copy of this script. Run this checkout's own copy instead.
own="$(git rev-parse --show-toplevel)/.husky/$(basename "$0")"
[ "$0" -ef "$own" ] || { [ -f "$own" ] && exec sh -e "$own" "$@"; exit 0; }

set -e

# Git hands the pushed refs on stdin, one "<local ref> <local sha> <remote ref>
# <remote sha>" per line. The commits a ref adds run from what the remote has
# to the local sha; a new branch, or a remote commit this clone lacks, counts
# from where the branch left develop. Clippy runs when any of them touch Rust,
# Nx for the projects they reach.
zero=0000000000000000000000000000000000000000
rust=no
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch deletion
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    remote_sha="$(git merge-base origin/develop "$local_sha")"
  fi
  if [ -n "$(git diff --name-only "$remote_sha" "$local_sha" -- crates Cargo.toml Cargo.lock rust-toolchain.toml)" ]; then
    rust=yes
  fi
  pnpm exec nx affected -t lint typecheck test --base="$remote_sha" --head="$local_sha" --outputStyle=static </dev/null
done

if [ "$rust" = yes ]; then
  SQLX_OFFLINE=true cargo clippy --all-targets -- -D warnings
fi
