#!/usr/bin/env sh
# Worktrees point core.hooksPath at the MAIN checkout's .husky/_, so git starts
# the main checkout's copy of this script. Run this checkout's own copy instead.
own="$(git rev-parse --show-toplevel)/.husky/$(basename "$0")"
[ "$0" -ef "$own" ] || { [ -f "$own" ] && exec sh -e "$own" "$@"; exit 0; }

set -e

# Git hands the pushed refs on stdin, one "<local ref> <local sha> <remote ref>
# <remote sha>" per line. A branch's own changes run from where it left develop
# to the local sha — counted from there and not from what the remote has, so a
# merge of develop into the branch does not make develop's changes its own.
# Clippy runs when they touch Rust, Nx for the projects they reach.
#
# Both check the files on disk, so they only speak for the checked-out commit.
# A ref pointing elsewhere — another branch, a tag object — is not checked
# here; CI checks it once it reaches a pull request or master.
zero=0000000000000000000000000000000000000000
head="$(git rev-parse HEAD)"
rust=no
while read -r local_ref local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue # a branch deletion
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit; not checked here (CI checks it through a pull request)."
    continue
  fi
  base="$(git merge-base origin/develop "$local_sha")"
  if [ -n "$(git diff --name-only "$base" "$local_sha" -- crates Cargo.toml Cargo.lock rust-toolchain.toml)" ]; then
    rust=yes
  fi
  pnpm exec nx affected -t lint typecheck test --base="$base" --head="$local_sha" --outputStyle=static </dev/null
done

if [ "$rust" = yes ]; then
  SQLX_OFFLINE=true cargo clippy --all-targets -- -D warnings
fi
