#!/usr/bin/env sh
# Worktrees point core.hooksPath at the MAIN checkout's .husky/_, so git starts
# the main checkout's copy of this script. Run this checkout's own copy instead.
own="$(git rev-parse --show-toplevel)/.husky/$(basename "$0")"
[ "$0" -ef "$own" ] || { [ -f "$own" ] && exec sh -e "$own" "$@"; exit 0; }

set -e

# Clippy only when the push carries Rust. Git hands the pushed refs on stdin,
# one "<local ref> <local sha> <remote ref> <remote sha>" per line. A new
# branch is compared from where it left develop; anything git cannot diff
# counts as Rust.
zero=0000000000000000000000000000000000000000
rust=no
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    remote_sha="$(git merge-base origin/develop "$local_sha" 2>/dev/null)" || { rust=yes; break; }
  fi
  changed="$(git diff --name-only "$remote_sha" "$local_sha" -- crates Cargo.toml Cargo.lock rust-toolchain.toml 2>/dev/null)" || { rust=yes; break; }
  if [ -n "$changed" ]; then rust=yes; break; fi
done

if [ "$rust" = yes ]; then
  SQLX_OFFLINE=true cargo clippy --all-targets -- -D warnings
fi
pnpm run -s verify:push
