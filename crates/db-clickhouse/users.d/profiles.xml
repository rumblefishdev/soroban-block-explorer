<!--
  RBAC profiles backing the per-service users in `services.xml`
  (task 0240). Mounted at /etc/clickhouse-server/users.d/profiles.xml.

  Profiles are intentionally NOT inheriting from `default` — the
  long timeouts in `timeouts.xml` (7200 s) are specific to the
  bulk-ingest workload and would be wrong defaults for read-only
  API queries. Each profile declares the timeouts and memory caps
  appropriate to its workload class.
-->
<clickhouse>
    <profiles>
        <admin>
            <readonly>0</readonly>
            <allow_ddl>1</allow_ddl>
            <max_memory_usage>20000000000</max_memory_usage>
            <http_receive_timeout>7200</http_receive_timeout>
            <http_send_timeout>7200</http_send_timeout>
            <receive_timeout>7200</receive_timeout>
            <send_timeout>7200</send_timeout>
        </admin>

        <read_only>
            <readonly>1</readonly>
            <allow_ddl>0</allow_ddl>
            <max_memory_usage>4000000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
        </read_only>

        <write_no_ddl>
            <readonly>0</readonly>
            <allow_ddl>0</allow_ddl>
            <max_memory_usage>8000000000</max_memory_usage>
            <max_insert_block_size>1048576</max_insert_block_size>
            <min_insert_block_size_rows>262144</min_insert_block_size_rows>
            <http_receive_timeout>7200</http_receive_timeout>
            <http_send_timeout>7200</http_send_timeout>
            <receive_timeout>7200</receive_timeout>
            <send_timeout>7200</send_timeout>
        </write_no_ddl>

        <!-- partition_only + migration_full profiles removed in task 0241
             along with their only consumers (the partition + migration
             Lambdas). -->
    </profiles>
</clickhouse>
