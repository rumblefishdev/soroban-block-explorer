{
  "name": "@rumblefish/soroban-block-explorer-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@rumblefish/api-types": "workspace:*",
    "@rumblefish/soroban-block-explorer-ui": "workspace:*",
    "@stellar/stellar-sdk": "17.0.1",
    "tslib": "^2.3.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "VITE_API_BASE_URL"
          },
          {
            "env": "VITE_TURNSTILE_SITE_KEY"
          },
          {
            "env": "VITE_STELLAR_NETWORK"
          }
        ]
      },
      "e2e": {
        "command": "pnpm exec playwright test",
        "options": {
          "cwd": "web"
        },
        "cache": false
      }
    }
  }
}
