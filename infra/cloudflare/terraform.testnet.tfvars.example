# Testnet's API host (task 0553). Copy to testnet.tfvars (gitignored) and use
# it in the `testnet` workspace — see README.md § Testnet. Same zone and
# rollout gates as production's terraform.tfvars.

cloudflare_zone_id = "REPLACE_WITH_RUMBLEFISHDEV_ZONE_ID"

api_hostname = "api-testnet-sorobanscan.rumblefishdev.com"

# CloudflareApiRegionalTarget output of Explorer-testnet-ApiGateway.
api_origin_target = "REPLACE_WITH_dYYYY.execute-api.eu-central-1.amazonaws.com"

create_dns_record   = false
enable_api_mtls_aop = false
