# Copy to backend.hcl (gitignored) and fill in. Then:
#   terraform init -backend-config=backend.hcl
#
# Bucket = the shared Soroban Cloudflare state bucket, soroban-infrastructure's
# cloudflare/state-bucket.yaml (task 0658): production-soroban-explorer-cf-tfstate.
# This repo's state is one key in it; it is separate from dns-cloudformation's bucket (D11).

bucket       = "production-soroban-explorer-cf-tfstate"
key          = "sorobanscan-api.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
