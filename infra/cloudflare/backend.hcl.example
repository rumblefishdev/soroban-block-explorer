# Example backend config for `terraform init -backend-config=backend.hcl`.
# Copy to backend.hcl (gitignored) and fill in. The bucket is provisioned BY
# CDK (CloudflareBootstrapStack) — do NOT create it by hand; read its name from
# the stack output (see README.md "One-time backend bootstrap").

bucket       = "production-soroban-explorer-cf-tfstate"  # = CDK output CloudflareTfStateBucketName
key          = "cloudflare/production/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true                                  # native S3 locking (TF >= 1.10)
