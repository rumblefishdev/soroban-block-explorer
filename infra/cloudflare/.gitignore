# Never commit real backend / var values or local TF state.
backend.hcl
terraform.tfvars
*.auto.tfvars

# Local Terraform working dir + state (state may carry the mTLS private key).
.terraform/
*.tfstate
*.tfstate.*
crash.log

# mTLS client cert + key (generated by the operator with openssl).
certs/

# DO track the lockfile when it exists — it is NOT secret and pins provider
# hashes for reproducible installs. The old (multi-provider) lockfile was
# removed with the module reshape; `terraform init` regenerates it and the
# negation below ensures the new one gets committed (keep it in lockstep with
# rf-domains' provider version, D10).
!.terraform.lock.hcl
