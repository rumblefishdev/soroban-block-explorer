# Terraform state (contains secrets — origin secret, mTLS key as attributes)
*.tfstate
*.tfstate.*
.terraform/
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it for
# reproducible provider versions (HashiCorp-recommended).

# Local/secret inputs — never commit. *.tfvars covers terraform.tfvars,
# *.auto.tfvars and any custom-named varfile (prod.tfvars, …); the tracked
# template ends in .tfvars.example so it is NOT matched.
*.tfvars
backend.hcl
certs/

# Crash logs / plans
crash.log
*.tfplan
