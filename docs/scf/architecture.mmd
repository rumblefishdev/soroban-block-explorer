%%{init: {"flowchart": {"curve": "basis"}}}%%
flowchart TB
    SP["Stellar mainnet peers"]

    subgraph AWS["AWS — eu‑central‑1"]
        direction TB
        AWS_IAC[" "]
        GAL["<b>Galexie · Captive Core</b><br/>production‑galexie‑live<br/><i>AWS ECS Fargate · always‑on</i>"]
        S3["<b>S3 bucket</b><br/>production‑stellar‑ledger‑data<br/><i>one .xdr.zst file per ledger</i>"]
        SNS["<b>SNS topic</b><br/>production‑ledger‑events<br/><i>fan‑out to per‑consumer queues</i>"]
        SQS["<b>SQS queue</b><br/>production‑ledger‑ingest<br/><i>batchSize 1 · ReportBatchItemFailures</i>"]
        LAM["<b>Ledger Processor · Lambda (Rust)</b><br/>production‑soroban‑explorer‑indexer<br/><i>reservedConcurrentExecutions=1</i><br/><i>600 s timeout · 540 s reconcile budget</i><br/><i>decode XDR, write typed rows</i>"]
        DLQ["<b>DLQ</b><br/>production‑ledger‑processor‑dlq<br/><i>persistent failures</i>"]
        ENQ["<b>SQS queue</b><br/>production‑enrichment<br/><i>off‑chain metadata lookups</i>"]
        EWK["<b>Enrichment Worker · Lambda (Rust)</b><br/>production‑soroban‑explorer‑enrichment‑worker<br/><i>icon URL + display name</i>"]
        EDLQ["<b>DLQ</b><br/>production‑enrichment‑dlq<br/><i>unreachable sources</i>"]
    end

    IAC["<b>Infrastructure as code</b><br/><i>AWS CDK + Ansible</i>"]

    subgraph HET[" "]
        CH[("<b>ClickHouse</b><br/><i>Hetzner · ch‑prod‑01</i><br/>ch.sorobanscan.rumblefish.dev<br/><i>single‑node MergeTree · Caddy mTLS</i>")]
    end

    SP -->|"streams closed ledgers"| GAL
    AWS_IAC ~~~ GAL
    GAL -->|"~1 file every 5–6 s"| S3
    S3 -->|"s3:ObjectCreated:* · suffix .xdr.zst"| SNS
    SNS -->|"subscribed queue"| SQS
    SQS -->|"triggers Lambda"| LAM
    LAM -.->|"on persistent failure"| DLQ
    LAM -->|"reconcile from max(sequence)+1<br/>write over mTLS"| CH
    LAM -.->|"enqueue metadata lookups"| ENQ
    ENQ --> EWK
    EWK -.->|"unreachable source"| EDLQ
    EWK -->|"write over mTLS"| CH

    IAC -.-> AWS_IAC
    IAC -.-> CH

    classDef ingestion fill:#FFE0B2,stroke:#E65100,stroke-width:1.5px,color:#BF360C
    classDef external  fill:#E3F2FD,stroke:#1565C0,stroke-width:1.5px,color:#0D47A1
    classDef database  fill:#FFCDD2,stroke:#B71C1C,stroke-width:2px,color:#B71C1C
    classDef iac       fill:#FAFAFA,stroke:#9E9E9E,stroke-width:1.5px,color:#424242,stroke-dasharray:4 3
    classDef hidden    fill:transparent,stroke:transparent,color:transparent

    class SP external
    class GAL,S3,SNS,SQS,LAM,DLQ,ENQ,EWK,EDLQ ingestion
